{
  "name": "@polka-codes/cli",
  "version": "0.13.1",
  "license": "AGPL-3.0",
  "author": "github@polka.codes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polka-codes/polka-codes.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "polka": "dist/bin.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --build --force && bun run ../../scripts/fix-declaration-imports.ts dist && bun build src/index.ts --outfile dist/index.js --target node --format esm --packages external --tsconfig-override=../../tsconfig.bundle.json --external=@polka-codes/core --external=@polka-codes/cli-shared && bun build src/bin.ts --outfile dist/bin.cjs --target node --format cjs --banner '#!/usr/bin/env node' && bun run build:copy-wasm",
    "build:copy-wasm": "mkdir -p dist && cp ../cli-shared/node_modules/sql.js/dist/sql-wasm.wasm dist/"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "@ai-sdk/deepseek": "^3.0.84",
    "@ai-sdk/google": "^4.0.117",
    "@ai-sdk/google-vertex": "^5.0.137",
    "@ai-sdk/openai": "^4.0.114",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@ai-sdk/provider": "^4.0.37",
    "@inquirer/prompts": "^8.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@polka-codes/cli-shared": "^0.13.1",
    "@polka-codes/core": "^0.13.1",
    "ai": "^7.0.169",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "lodash-es": "^4.18.1",
    "mime-types": "^3.0.2",
    "ora": "^10.0.0",
    "ulid": "^3.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/mime-types": "^3.0.1"
  }
}
